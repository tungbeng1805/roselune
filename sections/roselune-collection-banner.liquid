    {
      "type": "range",
      "id": "height",
      "label": "Desktop height",
      "default": 720,
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "default": 550,
      "min": 280,
      "max": 800,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "natural_mobile",
      "label": "Keep the full mobile image in view",
