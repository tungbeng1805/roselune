      "min": 1,
      "max": 6,
      "step": 1
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "label": "Tablet columns",
      "default": 3,
      "min": 1,
      "max": 4,
      "step": 1
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "default": "2",
