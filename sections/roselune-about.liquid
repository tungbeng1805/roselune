{% assign s = section.settings %}
{% render 'roselune-section-style' %}
<div class="roselune-section roselune-about-wrap">
  <div class="roselune-about-hero">
    <div class="roselune-inner roselune-about-grid">
      <div class="roselune-about-media">
        {% if s.image != blank %}
          {% render 'roselune-picture', image: s.image, alt: s.heading, sizes: '(max-width: 749px) 100vw, 45vw', max_width: 1200 %}
        {% else %}
          <img src="{{ 'roselune-mother.webp' | asset_url }}" alt="{{ s.heading | escape }}" loading="lazy" width="900" height="700">
        {% endif %}
      </div>
      <div class="roselune-about-copy">
        {% if s.kicker != blank %}<span class="roselune-kicker">{{ s.kicker | escape }}</span>{% endif %}
        <h1>{{ s.heading | escape }}</h1>
        {% if s.story != blank %}<p class="roselune-about-story">{{ s.story | escape }}</p>{% endif %}
        {% if s.button_label != blank %}
          <a class="roselune-pill-btn" href="{{ s.button_url | default: routes.all_products_collection_url | escape }}">{{ s.button_label | escape }} →</a>
        {% endif %}
      </div>
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="roselune-about-pillars">
      <div class="roselune-inner roselune-pillars-grid">
        {% for block in section.blocks %}
          {% assign b = block.settings %}
          <article class="roselune-pillar-card" {{ block.shopify_attributes }}>
            <h3>{{ b.title | escape }}</h3>
            <p>{{ b.description | escape }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .roselune-about-hero { background: #f9eff0; }
  .roselune-about-grid { display: grid; gap: clamp(24px, 4vw, 56px); align-items: center; }
  .roselune-about-media { border-radius: 14px; overflow: hidden; aspect-ratio: 4 / 3; }
  .roselune-about-media :is(.roselune-picture, img) { width: 100%; height: 100%; object-fit: cover; object-position: center 22%; display: block; }
  .roselune-about-copy { display: grid; gap: 14px; justify-items: start; }
  .roselune-about-copy h1 { font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: .08em; }
  .roselune-about-story { font-family: var(--roselune-font); font-style: italic; font-size: clamp(1rem, 1.35vw, 1.2rem); line-height: 1.65; }
  .roselune-about-pillars { background: #ffffff; }
  .roselune-pillars-grid { display: grid; gap: 22px; }
  .roselune-pillar-card { background: #fbf8f4; padding: clamp(20px, 2.5vw, 30px); border-radius: 12px; text-align: center; display: grid; gap: 8px; }
  .roselune-pillar-card h3 { font-size: 1.15rem; }
  .roselune-pillar-card p { font-size: .9rem; opacity: .85; line-height: 1.6; }
  @media (min-width: 750px) {
    .roselune-about-grid { grid-template-columns: 1fr 1.1fr; }
    .roselune-pillars-grid { grid-template-columns: repeat(3, 1fr); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ROSELUNE About Us",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Our Heritage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHERE LITTLE DREAMS BLOOM"
    },
    {
      "type": "textarea",
      "id": "story",
      "label": "Brand story",
      "default": "Founded with a devotion to childhood wonder, ROSELUNE crafts heirloom-quality princess couture in silk, French tulle, and delicate hand-sewn florals."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Atelier image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#752b36"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#5c3e43"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Desktop vertical padding",
      "default": 52,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile vertical padding",
      "default": 28,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Craftsmanship pillar",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ROSELUNE About Us"
    }
  ]
}
{% endschema %}
