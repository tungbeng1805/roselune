{% assign s = section.settings %}
{% render 'roselune-section-style' %}
{% liquid
  assign brand = s.brand | default: shop.name
  assign logo = s.logo | default: settings.logo
  assign root_prefix = routes.root_url
  unless root_prefix == '/'
    assign root_prefix = root_prefix | append: '/' | replace: '//', '/'
  endunless
  assign has_social_urls = false
  if s.instagram_url != blank or s.facebook_url != blank or s.tiktok_url != blank or s.youtube_url != blank
    assign has_social_urls = true
  endif
%}
<div class="roselune-section roselune-footer roselune-flower-corners">
  <div class="roselune-inner">
    <div class="roselune-footer-columns">
      <div class="roselune-footer-brand">
        <a href="{{ routes.root_url }}" aria-label="{{ brand | escape }}">
          {% if logo %}{% render 'roselune-picture', image: logo, sizes: '200px', max_width: 600, alt: brand %}
          {% elsif s.bundled_logo %}{% render 'roselune-brand-mark', brand: brand, lazy: true %}
          {% else %}<span class="roselune-wordmark">{{ brand | escape }}</span>{% endif %}
        </a>
        {% if s.descriptor != blank %}<p class="roselune-kicker">{{ s.descriptor | escape }}</p>{% endif %}
        {% if s.tagline != blank %}<p class="roselune-script">{{ s.tagline | escape }}</p>{% endif %}
        {% if s.story_heading != blank or s.description != blank %}
          <div class="roselune-footer-story-wrap">
            {% if s.story_heading != blank %}<h2 class="roselune-footer-heading">{{ s.story_heading | escape }}</h2>{% endif %}
            {% if s.description != blank %}<p class="roselune-footer-story">{{ s.description | escape }}</p>{% endif %}
            {% if s.story_url != blank %}<a class="roselune-footer-story-link" href="{{ s.story_url | escape }}">{{ s.story_link_label | default: 'Read our story' | escape }} →</a>{% endif %}
          </div>
        {% endif %}
      </div>
      {% for block in section.blocks %}
        {% assign b = block.settings %}
        {% assign heading_key = b.heading | downcase | strip %}
        {% capture column %}
          <details {{ block.shopify_attributes }}>
            <summary>{{ b.heading | default: b.menu.title | escape }}</summary>
            {% if b.menu.links != blank %}
              <nav class="details-content" aria-label="{{ b.heading | default: b.menu.title | escape }}">
                <ul>{% for link in b.menu.links %}
                  <li><a href="{{ link.url | escape }}">{{ link.title | escape }}</a></li>
                {% endfor %}</ul>
              </nav>
            {% elsif heading_key == 'shop' %}
              <nav class="details-content" aria-label="{{ b.heading | escape }}">
                <ul>
                  {% render 'roselune-product-groups', mode: 'desktop', start: 0, count: 4 %}
                </ul>
              </nav>
            {% elsif heading_key == 'about' %}
              <nav class="details-content" aria-label="{{ b.heading | escape }}">
                <ul>
                  <li><a href="{{ root_prefix }}pages/about">Brand Story</a></li>
                  <li><a href="{{ root_prefix }}pages/size-guide">Size Guide</a></li>
                  <li><a href="{{ root_prefix }}pages/contact">Contact Us</a></li>
                </ul>
              </nav>
            {% elsif heading_key contains 'care' %}
              <nav class="details-content" aria-label="{{ b.heading | escape }}">
                <ul>
                  <li><a href="{{ routes.account_url }}">My Account</a></li>
                  <li><a href="{{ routes.cart_url }}">Shopping Bag</a></li>
                  <li><a href="{{ root_prefix }}pages/contact">Personal Styling</a></li>
                </ul>
              </nav>
            {% elsif request.design_mode %}
              <p>Choose the menu for this column.</p>
            {% endif %}
          </details>
        {% endcapture %}
        {% render 'accordion-custom-component', children: column, class: 'roselune-footer-menu', disable_on_desktop: true, open_by_default_on_desktop: true %}
      {% endfor %}
      {% if s.social_menu.links != blank or has_social_urls or s.footer_signup or shop.customer_accounts_enabled %}
        <div class="roselune-footer-connect">
          {% if s.social_heading != blank %}<h2 class="roselune-footer-heading">{{ s.social_heading | escape }}</h2>{% endif %}
          {% if has_social_urls %}
            <div class="roselune-footer-socials">
              {% if s.instagram_url != blank %}
                <a class="roselune-social-btn" href="{{ s.instagram_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                  <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">{% render 'icon', icon: 'instagram' %}</svg>
                </a>
              {% endif %}
              {% if s.facebook_url != blank %}
                <a class="roselune-social-btn" href="{{ s.facebook_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                  <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">{% render 'icon', icon: 'facebook' %}</svg>
                </a>
              {% endif %}
              {% if s.tiktok_url != blank %}
                <a class="roselune-social-btn" href="{{ s.tiktok_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                  <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">{% render 'icon', icon: 'tiktok' %}</svg>
                </a>
              {% endif %}
              {% if s.youtube_url != blank %}
                <a class="roselune-social-btn" href="{{ s.youtube_url | escape }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                  <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">{% render 'icon', icon: 'youtube' %}</svg>
                </a>
              {% endif %}
            </div>
          {% endif %}
          {% if s.social_menu.links != blank %}
            <div class="roselune-footer-social-links">
              {% for link in s.social_menu.links %}<a href="{{ link.url | escape }}">{{ link.title | escape }}</a>{% endfor %}
            </div>
          {% endif %}
          {% if s.footer_signup %}{% render 'roselune-signup', label: s.subscribe_label %}{% endif %}
          {% if shop.customer_accounts_enabled and s.show_account_link %}
            <a class="roselune-footer-account" href="{{ routes.account_url }}">{{ s.account_label | default: 'Sign in / Create account' | escape }} →</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
    <div class="roselune-footer-base">
      <small>&copy; {{ 'now' | date: '%Y' }} {{ s.copyright | default: brand | escape }}</small>
      {% if s.show_policies %}
        {% for policy in shop.policies %}{% if policy != blank %}
          <a href="{{ policy.url | escape }}">{{ policy.title | escape }}</a>
        {% endif %}{% endfor %}
      {% endif %}
      {% render 'roselune-localization', s: s %}
      {% if s.show_payments and shop.enabled_payment_types.size > 0 %}
        <ul class="roselune-payments" aria-label="{{ 'blocks.payment_methods' | t }}">
          {% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</div>
{% stylesheet %}
  .roselune-footer-columns { display: grid; gap: 24px; align-items: start; }
  .roselune-footer-columns > * { min-width: 0; }
  .roselune-footer :is(ul, li) { padding: 0; margin: 0; list-style: none; }
  .roselune-footer a { text-decoration: none; color: inherit; }
  .roselune-footer a:hover { text-decoration: underline; text-underline-offset: .25em; }
  .roselune-footer-brand, .roselune-footer-connect { display: grid; justify-items: start; gap: 12px; }
  .roselune-footer-brand .roselune-picture { max-width: 180px; }
  .roselune-footer-brand .roselune-brand-art { width: min(145px, 100%); }
  .roselune-footer-story-wrap { display: grid; gap: 6px; max-width: 36ch; }
  .roselune-footer-story { font-size: .88rem; line-height: 1.65; opacity: .9; }
  .roselune-footer-story-link, .roselune-footer-account { font-size: .82rem; letter-spacing: .04em; text-decoration: underline; text-underline-offset: .25em; }
  .roselune-footer::before { display: none; }
  .roselune-footer::after { bottom: 0; top: auto; transform: rotate(180deg); }
  .roselune-footer-brand .roselune-wordmark { font-size: clamp(1.5rem, 2.5vw, 2.8rem); }
  .roselune-footer-brand .roselune-script { font-size: 1.25rem; }
  .roselune-footer-menu { display: block; border-block-end: 1px solid color-mix(in srgb, currentColor 25%, transparent); }
  .roselune-footer-menu summary, .roselune-footer-heading { padding-block: 8px; font: inherit; font-size: .78rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; cursor: pointer; }
  .roselune-footer-heading { cursor: default; padding-block: 0; margin: 0; }
  .roselune-footer-menu a { display: inline-flex; align-items: center; min-height: 34px; font-size: .9rem; }
  .roselune-footer-socials { display: flex; flex-wrap: wrap; gap: 10px; }
  .roselune-social-btn {
    width: 38px; height: 38px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    background: rgba(255, 255, 255, 0.55); transition: background-color .2s ease, border-color .2s ease;
  }
  .roselune-social-btn:hover { background: #ffffff; border-color: currentColor; text-decoration: none; }
  .roselune-footer-social-links { display: flex; flex-wrap: wrap; gap: 8px 14px; font-size: .88rem; }
  .roselune-footer .roselune-signup { max-width: 24rem; }
  .roselune-footer .roselune-signup-fields input {
    min-height: 42px; background: rgba(255, 255, 255, 0.72);
    border: 1px solid color-mix(in srgb, currentColor 26%, transparent); border-radius: 4px; font-size: .88rem;
  }
  .roselune-footer .roselune-signup-fields button { min-height: 42px; padding-inline: 18px; border-radius: 4px; }
  .roselune-footer-base { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; border-top: 1px solid color-mix(in srgb, currentColor 22%, transparent); margin-top: 32px; padding-top: 20px; font-size: .85rem; }
  .roselune-payments { display: flex; flex-wrap: wrap; gap: 6px; }
  .roselune-payments svg { width: 38px; height: 24px; }
  @media (min-width: 750px) {
    .roselune-footer-columns { display: flex; flex-wrap: wrap; gap: clamp(24px, 3vw, 52px); align-items: start; }
    .roselune-footer-brand { flex: 1.4 1 230px; }
    .roselune-footer-menu { flex: 0.8 1 130px; border: 0; }
    .roselune-footer-connect { flex: 1.35 1 250px; }
    .roselune-footer-menu summary { list-style: none; cursor: default; padding-block: 0 8px; }
    .roselune-payments { margin-inline-start: auto; }
  }
{% endstylesheet %}

