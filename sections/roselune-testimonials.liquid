    },
    {
      "type": "checkbox",
      "id": "pagination",
      "label": "Show pagination",
      "default": false
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "playfair_display_n4"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f4dfe2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#60383b"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#60383b"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Button background",
      "default": "#974158"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#fcf8f3"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#89552e"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Desktop vertical padding",
      "default": 64,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile vertical padding",
      "default": 36,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "ROSELUNE feedback"
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "blocks": [
    {
      "type": "roselune-review",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "customer",
          "label": "Customer name"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Customer photo"
        },
        {
          "type": "checkbox",
          "id": "show_rating",
          "label": "Display verified rating",
          "default": false
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "default": 5,
          "min": 1,
          "max": 5,
          "step": 1
