{% assign s = section.settings %}
{% render 'roselune-section-style' %}
{% capture reviews %}
  {% for block in section.blocks %}
    {% assign b = block.settings %}
    {% if b.review != blank %}
      <li {{ block.shopify_attributes }}>
        <figure class="roselune-review">
          {% if b.photo %}
            {% render 'roselune-picture', image: b.photo, sizes: '(max-width: 749px) 100vw, 33vw', max_width: 960 %}
          {% endif %}
          {% if b.show_rating %}
            <span class="roselune-stars" role="img" aria-label="{{ 'accessibility.rating' | t: rating: b.rating }}">
              <span aria-hidden="true">{% for star in (1..b.rating) %}★{% endfor %}</span>
            </span>
          {% endif %}
          {% if b.title != blank %}<h3>{{ b.title | escape }}</h3>{% endif %}
          <blockquote>{{ b.review | escape | newline_to_br }}</blockquote>
          <figcaption>
            {% if b.avatar %}{{ b.avatar | image_url: width: 96 | image_tag: widths: '48, 96', sizes: '48px', loading: 'lazy', alt: '' }}{% endif %}
            <span>{{ b.customer | escape }}{% if b.location != blank %}<small>{{ b.location | escape }}</small>{% endif %}</span>
          </figcaption>
          {% if b.product %}<a href="{{ b.product.url | escape }}">{{ b.product.title | escape }}</a>{% endif %}
        </figure>
      </li>
    {% elsif request.design_mode %}
      <li class="roselune-editor-note" {{ block.shopify_attributes }}>Enter a genuine customer review to show this card.</li>
    {% endif %}
  {% endfor %}
{% endcapture %}
{% assign reviews = reviews | strip %}
{% if reviews != blank or request.design_mode %}
  <div class="roselune-section" style="--roselune-card: {{ s.card_background }}; --roselune-star: {{ s.star_color }}">
    <div class="roselune-inner roselune-feedback">
      {% render 'roselune-intro', s: s, center: true %}
      {% if reviews != blank %}{% render 'roselune-rail', items: reviews, s: s %}
      {% else %}<p class="roselune-editor-note">Add a testimonial with customer feedback to display this section.</p>{% endif %}
    </div>
  </div>
{% endif %}
{% stylesheet %}
  .roselune-feedback { display: grid; gap: clamp(24px, 3vw, 40px); }
  .roselune-review {
    background: var(--roselune-card); padding: clamp(20px, 2.4vw, 30px);
    box-shadow: 0 4px 20px rgba(117, 43, 54, 0.04); border-radius: 10px;
    display: grid; align-content: start; gap: 12px; height: 100%;
  }
  .roselune-review blockquote { font-family: var(--roselune-font); font-style: italic; font-size: clamp(1rem, 1.35vw, 1.2rem); line-height: 1.55; }
  .roselune-stars { color: var(--roselune-star); letter-spacing: .15em; font-size: .85rem; }
  .roselune-review figcaption { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; font-size: .8rem; opacity: .78; }
  .roselune-review figcaption img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
  .roselune-review small { display: block; }
{% endstylesheet %}

{% schema %}
{
  "name": "ROSELUNE feedback",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CUSTOMER FEEDBACK"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "default": 3,
      "min": 1,
      "max": 6,
      "step": 1
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "label": "Tablet columns",
      "default": 3,
      "min": 1,
      "max": 4,
      "step": 1
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Item gap",
      "default": 18,
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "display",
      "label": "Display mode",
      "default": "carousel",
      "options": [
        {
          "value": "carousel",
          "label": "Carousel"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "arrows",
      "label": "Show arrows",
