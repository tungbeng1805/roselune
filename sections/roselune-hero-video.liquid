{% assign s = section.settings %}
{% render 'roselune-section-style' %}
{% if s.height_mode == 'full_viewport' %}
  {% render 'measure-header-heights', only_when_first_section: true %}
{% endif %}
{% liquid
  assign priority = false
  if section.index == 1
    assign priority = true
  endif
  assign heading = s.heading | default: shop.name
%}
{% style %}
  #shopify-section-{{ section.id }} {
    --roselune-height: {{ s.height }}px;
    --roselune-mobile-height: {{ s.mobile_height }}px;
    --roselune-position: {{ s.position }};
    --roselune-overlay-fill: {{ s.overlay }};
    --roselune-opacity: {{ s.opacity | divided_by: 100.0 }};
    --roselune-placement: {{ s.desktop_position }};
    --roselune-mobile-placement: {{ s.mobile_position }};
    --roselune-vertical: {{ s.vertical }};
    --roselune-mobile-vertical: {{ s.mobile_vertical }};
    --roselune-align: {{ s.alignment }};
  }
{% endstyle %}
<div class="roselune-section roselune-hero{% if s.height_mode == 'full_viewport' %} roselune-hero--fullscreen{% elsif s.height_mode == 'panoramic' %} roselune-hero--panorama{% endif %}">
  {% render 'roselune-campaign-media', s: s, priority: priority, ambient: s.autoplay %}
  <div class="roselune-hero-copy">
    <h1{% if s.logo %} class="roselune-hero-logo"{% endif %}>
      {% if s.logo %}
        {{ s.logo | image_url: width: 800 | image_tag: widths: '240, 400, 600, 800', sizes: 'min(60vw, 400px)', alt: heading, loading: 'eager' }}
      {% else %}{{ heading | escape }}{% endif %}
    </h1>
    {% if s.subheading != blank %}<p class="roselune-kicker">{{ s.subheading | escape }}</p>{% endif %}
    {% if s.tagline != blank %}<p class="roselune-script">{{ s.tagline | escape }}</p>{% endif %}
    {% if s.description != blank %}<p>{{ s.description | escape }}</p>{% endif %}
    {% if s.button_url != blank or s.secondary_url != blank %}
      <div class="roselune-hero-buttons">
        {% if s.button_url != blank and s.button_label != blank %}<a class="roselune-button" href="{{ s.button_url | escape }}">{{ s.button_label | escape }}</a>{% endif %}
        {% if s.secondary_url != blank and s.secondary_label != blank %}<a class="roselune-button roselune-button--outline" href="{{ s.secondary_url | escape }}">{{ s.secondary_label | escape }}</a>{% endif %}
      </div>
    {% endif %}
  </div>
  {% if s.height_mode == 'full_viewport' %}
    <a class="roselune-hero-scroll" href="#princess-dress" aria-label="Explore collections">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
    </a>
  {% endif %}
</div>
{% stylesheet %}
  .roselune-hero {
    isolation: isolate; position: relative; display: grid; align-items: var(--roselune-mobile-vertical); justify-items: var(--roselune-mobile-placement);
    min-height: var(--roselune-mobile-height); padding: calc(58px + var(--roselune-pad-mobile)) clamp(20px, 6vw, 120px);
  }
  .roselune-hero::after { content: ''; position: absolute; inset: 0; background: var(--roselune-overlay-fill); opacity: var(--roselune-opacity); pointer-events: none; }
  .roselune-hero-copy { z-index: 1; display: grid; gap: 14px; width: fit-content; max-width: min(100%, 65ch); justify-items: var(--roselune-align); text-align: var(--roselune-align); }
  .roselune-hero h1 { letter-spacing: .08em; font-size: clamp(2.4rem, 7vw, 7.5rem); }
  .roselune-hero-logo img { width: min(60vw, 400px); height: auto; }
  .roselune-hero-buttons { display: flex; flex-wrap: wrap; gap: 12px; justify-content: var(--roselune-align); }
  .roselune-hero-scroll {
    position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%); z-index: 2;
    width: 44px; height: 44px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    color: #ffffff; border: 1px solid rgba(255, 255, 255, 0.45); background: rgba(52, 29, 29, 0.28);
    backdrop-filter: blur(4px); text-decoration: none;
    transition: transform .25s ease, background-color .25s ease;
  }
  .roselune-hero-scroll:hover { transform: translate(-50%, 3px); background: rgba(52, 29, 29, 0.5); }
  .page-wrapper:has(.roselune-header-wrap:last-child [data-roselune-transparent]) #MainContent > :first-child .roselune-hero {
    padding-block-start: calc(var(--header-height, 0px) + 58px + var(--roselune-pad-mobile));
  }
  @media (min-width: 750px) {
    .roselune-hero { align-items: var(--roselune-vertical); justify-items: var(--roselune-placement); min-height: var(--roselune-height); padding-block: calc(58px + var(--roselune-pad)); }
    .roselune-hero--fullscreen {
      min-height: clamp(460px, calc(100svh - var(--header-group-height, 100px)), 960px);
      padding-block: calc(40px + var(--roselune-pad)); padding-inline: clamp(32px, 8vw, 160px);
    }
    .roselune-hero--fullscreen h1 { font-size: clamp(2.8rem, 4.8vw, 5.4rem); }
    .roselune-hero--fullscreen .roselune-hero-copy { gap: 10px; }
    .roselune-hero--fullscreen .roselune-script { font-size: clamp(1.35rem, 2.2vw, 2.35rem); margin-top: 8px; white-space: nowrap; }
    .roselune-hero--panorama { min-height: clamp(260px, 24vw, var(--roselune-height)); padding-block: calc(30px + var(--roselune-pad)); padding-inline: clamp(30px, 10vw, 200px); }
    .roselune-hero--panorama h1 { font-size: clamp(2.3rem, 3.8vw, 4.8rem); }
    .roselune-hero--panorama .roselune-hero-copy { gap: 6px; }
    .roselune-hero--panorama .roselune-script { margin-top: 12px; }
  }
  @media (max-width: 749px) {
    :is(.roselune-hero--panorama, .roselune-hero--fullscreen)::after { background: linear-gradient(to top, var(--roselune-overlay-fill), transparent 65%); opacity: .85; }
    :is(.roselune-hero--panorama, .roselune-hero--fullscreen) { padding-block: calc(34px + var(--roselune-pad-mobile)); }
    :is(.roselune-hero--panorama, .roselune-hero--fullscreen) .roselune-hero-copy { gap: 5px; }
    .roselune-hero--fullscreen { min-height: max(var(--roselune-mobile-height), calc(78svh - var(--header-group-height, 84px))); }
    .roselune-hero-scroll { display: none; }
  }
{% endstylesheet %}

