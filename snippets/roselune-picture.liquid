{% doc %}
  Responsive art direction. When only one image exists it serves both viewports.
  @param {image} image
  @param {image} [mobile]
  @param {string} [sizes]
  @param {string} [alt]
  @param {boolean} [priority]
  @param {number} [max_width]
{% enddoc %}
{% liquid
  assign desktop = image | default: mobile
  assign sizes = sizes | default: '100vw'
  assign limit = max_width | default: 2400
  assign loading = 'lazy'
  assign fetch_priority = 'auto'
  if priority
    assign loading = 'eager'
    assign fetch_priority = 'high'
  endif
  assign alt_text = alt | default: desktop.alt
%}
{% if desktop != blank %}
  <picture class="roselune-picture">
    {% if mobile != blank and mobile != desktop %}
      <source media="(max-width: 749px)" width="{{ mobile.width }}" height="{{ mobile.height }}"
        srcset="{{ mobile | image_url: width: 360 }} 360w, {{ mobile | image_url: width: 540 }} 540w, {{ mobile | image_url: width: 750 }} 750w, {{ mobile | image_url: width: 1080 }} 1080w"
        sizes="{{ sizes }}">
    {% endif %}
    {{ desktop | image_url: width: limit | image_tag: widths: '120, 240, 360, 480, 640, 750, 960, 1200, 1600, 1920, 2400', sizes: sizes, loading: loading, fetchpriority: fetch_priority, alt: alt_text }}
  </picture>
{% endif %}
