{% doc %}
  @param {object} s - Section settings
{% enddoc %}
{% liquid
  assign countries = false
  assign languages = false
  if s.show_country and localization.available_countries.size > 1
    assign countries = true
  endif
  if s.show_language and localization.available_languages.size > 1
    assign languages = true
  endif
  assign form_id = 'roselune-locale-' | append: section.id
%}
{% if countries or languages %}
  <details class="roselune-localization">
    <summary aria-label="{{ 'accessibility.localization_region_and_language' | t }}">
      {% if countries %}{{ localization.country.iso_code }} · {{ localization.country.currency.iso_code }}{% endif %}
      {% if languages %}{{ localization.language.endonym_name | escape }}{% endif %}
    </summary>
    {% form 'localization', id: form_id %}
      {% if countries %}
        <label>{{ 'accessibility.country_region' | t }}
          <select name="country_code">
            {% for country in localization.available_countries %}
              <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name | escape }} ({{ country.currency.iso_code }})</option>
            {% endfor %}
          </select>
        </label>
      {% endif %}
      {% if languages %}
        <label>{{ 'content.language' | t }}
          <select name="language_code">
            {% for language in localization.available_languages %}
              <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | escape }}</option>
            {% endfor %}
          </select>
        </label>
      {% endif %}
      <button class="roselune-button" type="submit">{{ 'actions.apply' | t }}</button>
    {% endform %}
  </details>
{% endif %}
{% stylesheet %}
  .roselune-localization { max-width: 100%; }
  .roselune-localization summary { cursor: pointer; line-height: 1.3; padding: 12px 6px; font-size: .85rem; }
  .roselune-localization form, .roselune-localization label { display: grid; gap: 8px; }
  .roselune-localization select { width: 100%; min-height: 44px; background: var(--roselune-bg); color: var(--roselune-ink); }
{% endstylesheet %}
