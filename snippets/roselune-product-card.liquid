{% doc %}
  @param {product} item - A real product from the merchant's selection
  @param {object} s - Section settings
  @param {string} sizes - Responsive image slot sizes
{% enddoc %}
{% liquid
  assign variant = item.selected_or_first_available_variant
  assign secondary = item.images[1]
  assign show_quick = false
  if s.show_quick_add and settings.quick_add and item.available
    assign show_quick = true
  endif
%}
<product-card class="roselune-product" data-product-id="{{ item.id }}"
  view-event-payload="{{ item | standard_event_data: 'view', context: 'collection' | escape }}">
  <div class="roselune-product-media">
    <a href="{{ item.url | escape }}" ref="productCardLink" aria-label="{{ item.title | escape }}">
      {% if item.featured_media.preview_image %}
        {% render 'roselune-picture', image: item.featured_media.preview_image, alt: item.title, sizes: sizes, max_width: 1200 %}
        {% if secondary and secondary != item.featured_media.preview_image %}
          {{ secondary | image_url: width: 1200 | image_tag: class: 'roselune-secondary', widths: '240, 360, 480, 750, 960, 1200', sizes: sizes, loading: 'lazy', alt: '' }}
        {% endif %}
      {% else %}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'roselune-placeholder' }}
      {% endif %}
    </a>
    {% if s.show_badges != false %}
      {% if item.available == false %}
        <span class="roselune-badge">{{ 'content.product_badge_sold_out' | t }}</span>
      {% elsif variant.compare_at_price > variant.price %}
        <span class="roselune-badge">{{ 'content.product_badge_sale' | t }}</span>
      {% endif %}
    {% endif %}
    {% if show_quick %}
      {% render 'quick-add', product: item, section_id: section.id, block: section %}
    {% endif %}
  </div>
  <div class="roselune-product-copy">
    <h3><a href="{{ item.url | escape }}">{{ item.title | escape }}</a></h3>
    {% if s.show_price != false %}{% render 'price', product_resource: item, show_unit_price: true %}{% endif %}
    {% if s.show_swatches != false %}
      {% for option in item.options_with_values %}
        {% assign values = option.values | map: 'swatch' | compact %}
        {% if values.size > 0 %}
          {% render 'swatch-styles' %}
          <div class="roselune-swatches" aria-label="{{ option.name | escape }}">
            {% for value in option.values %}
              {% if value.swatch %}
                <a href="{{ value.variant.url | default: item.url | escape }}" aria-label="{{ value.name | escape }}" title="{{ value.name | escape }}">
                  {% render 'swatch', swatch: value.swatch, mode: 'unscaled' %}
                </a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}
    {% if s.show_options and item.has_only_default_variant == false %}
      <a class="roselune-options" href="{{ item.url | escape }}">{{ s.options_label | default: 'Choose options' | escape }}</a>
    {% endif %}
  </div>
</product-card>

{% stylesheet %}
  .roselune-product { display: block; min-width: 0; }
  .roselune-product-media { position: relative; aspect-ratio: var(--roselune-ratio); border-radius: var(--roselune-radius); background: color-mix(in srgb, var(--roselune-ink) 6%, var(--roselune-bg)); }
  .roselune-product-media > a { position: absolute; inset: 0; overflow: hidden; border-radius: inherit; }
  .roselune-product-media :is(.roselune-picture, img) { width: 100%; height: 100%; object-fit: var(--roselune-fit); }
  .roselune-secondary { position: absolute; inset: 0; opacity: 0; }
  @media (hover: hover) { .roselune-product-media:hover .roselune-secondary { opacity: 1; } }
  .roselune-badge { pointer-events: none; position: absolute; top: 8px; inset-inline-start: 8px; background: var(--roselune-bg); color: var(--roselune-ink); padding: 4px 9px; font-size: .72rem; }
  .roselune-product-copy { text-align: var(--roselune-info-align); padding-block: 12px 4px; display: grid; gap: 6px; }
  .roselune-product-copy h3 a { color: inherit; text-decoration: none; }
  .roselune-product-copy h3 a:hover { text-decoration: underline; text-underline-offset: .2em; }
  .roselune-options {
    display: inline-flex; align-items: center; justify-content: center; justify-self: center;
    padding: 6px 16px; border: 1px solid color-mix(in srgb, var(--roselune-heading) 45%, transparent);
    border-radius: 3px; background: rgba(255, 255, 255, 0.65); color: var(--roselune-heading);
    font-family: var(--roselune-font); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase;
    text-decoration: none; transition: background-color .2s ease, border-color .2s ease;
  }
  .roselune-options:hover { background: rgba(255, 255, 255, 0.95); border-color: var(--roselune-heading); }
  .roselune-swatches { display: flex; flex-wrap: wrap; justify-content: var(--roselune-info-align); gap: 2px; }
  .roselune-swatches a { width: 28px; height: 28px; display: grid; place-items: center; }
  .roselune-swatches .swatch { width: 18px; height: 18px; }
  .roselune-product .quick-add { --padding-inline-end: 0px; --padding-block-end: 0px; --border-radius: var(--roselune-radius); }
{% endstylesheet %}
